<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>حسابي | المدير المالي لمشروعك</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f3f6fa;
      color: #1e293b;
    }

    header {
      background: #102b46;
      color: white;
      padding: 28px 20px;
      text-align: center;
    }

    header h1 {
      margin: 0 0 10px;
      font-size: 34px;
    }

    header p {
      margin: 0;
      color: #d7e5f5;
    }

    .container {
      width: 92%;
      max-width: 1000px;
      margin: 25px auto;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
    }

    .card {
      background: white;
      padding: 22px;
      border-radius: 14px;
      box-shadow: 0 3px 12px #0000000d;
      border-top: 4px solid #2563eb;
    }

    .card h3 {
      margin: 0 0 15px;
      font-size: 17px;
      color: #64748b;
    }

    .amount {
      font-size: 25px;
      font-weight: bold;
      overflow-wrap: anywhere;
    }

    .income {
      border-color: #16a34a;
    }

    .expenses {
      border-color: #dc2626;
    }

    .balance {
      border-color: #2563eb;
    }

    .section {
      margin-top: 25px;
      background: white;
      padding: 22px;
      border-radius: 14px;
      box-shadow: 0 3px 12px #0000000d;
    }

    .section h2 {
      margin-top: 0;
    }

    .form {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
    }

    input, select, button {
      width: 100%;
      padding: 13px;
      border-radius: 8px;
      font-size: 15px;
    }

    input, select {
      border: 1px solid #cbd5e1;
      background: white;
    }

    button {
      border: none;
      cursor: pointer;
      font-weight: bold;
      background: #2563eb;
      color: white;
    }

    button:hover {
      opacity: 0.9;
    }

    .delete {
      width: auto;
      padding: 8px 12px;
      background: #dc2626;
    }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 500px;
    }

    th, td {
      padding: 13px 10px;
      border-bottom: 1px solid #e2e8f0;
      text-align: right;
    }

    th {
      background: #f8fafc;
    }

    footer {
      text-align: center;
      padding: 25px;
      color: #64748b;
    }

    .note {
      font-size: 13px;
      color: #64748b;
      line-height: 1.8;
    }
  </style>
</head>

<body>

<header>
  <h1>حسابي</h1>
  <p>المدير المالي لمشروعك</p>
  <p>Le directeur financier de votre projet</p>
</header>

<main class="container">

  <section class="cards">

    <div class="card income">
      <h3>إجمالي الإيرادات</h3>
      <div class="amount" id="totalIncome">0</div>
      <small>أوقية جديدة (MRU)</small>
    </div>

    <div class="card expenses">
      <h3>إجمالي المصروفات</h3>
      <div class="amount" id="totalExpenses">0</div>
      <small>أوقية جديدة (MRU)</small>
    </div>

    <div class="card balance">
      <h3>الرصيد المتبقي</h3>
      <div class="amount" id="balance">0</div>
      <small>أوقية جديدة (MRU)</small>
    </div>

  </section>

  <section class="section">
    <h2>إضافة عملية مالية</h2>

    <form id="transactionForm">
      <div class="form">

        <select id="type" required>
          <option value="income">إيراد</option>
          <option value="expense">مصروف</option>
        </select>

        <input
          id="description"
          type="text"
          placeholder="وصف العملية"
          required
        >

        <input
          id="amount"
          type="number"
          min="0.01"
          step="0.01"
          placeholder="المبلغ بالأوقية الجديدة"
          required
        >

        <input id="date" type="date" required>

        <button type="submit">حفظ العملية</button>

      </div>
    </form>

    <p class="note">
      سجّل كل إيراد أو مصروف لمتابعة وضعك المالي.
      تُحفظ هذه النسخة التجريبية على هذا المتصفح فقط.
    </p>
  </section>

  <section class="section">
    <h2>سجل العمليات المالية</h2>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>التاريخ</th>
            <th>النوع</th>
            <th>الوصف</th>
            <th>المبلغ</th>
            <th>إجراء</th>
          </tr>
        </thead>

        <tbody id="transactionsList"></tbody>
      </table>
    </div>

    <p id="emptyMessage">لا توجد عمليات مالية حتى الآن.</p>
  </section>

</main>

<footer>
  حسابي © 2026 — إدارة مالية أكثر وضوحًا
</footer>

<script>
  const form = document.getElementById("transactionForm");
  const typeInput = document.getElementById("type");
  const descriptionInput = document.getElementById("description");
  const amountInput = document.getElementById("amount");
  const dateInput = document.getElementById("date");
  const list = document.getElementById("transactionsList");

  let transactions = [];

  try {
    const saved = localStorage.getItem("hisabiTransactions");
    transactions = saved ? JSON.parse(saved) : [];

    if (!Array.isArray(transactions)) {
      transactions = [];
    }
  } catch (error) {
    transactions = [];
  }

  dateInput.value = new Date().toISOString().slice(0, 10);

  function formatMoney(value) {
    return new Intl.NumberFormat("ar-MR", {
      maximumFractionDigits: 2
    }).format(value);
  }

  function saveTransactions() {
    localStorage.setItem(
      "hisabiTransactions",
      JSON.stringify(transactions)
    );
  }

  function render() {
    const income = transactions
      .filter(item => item.type === "income")
      .reduce((sum, item) => sum + item.amount, 0);

    const expenses = transactions
      .filter(item => item.type === "expense")
      .reduce((sum, item) => sum + item.amount, 0);

    document.getElementById("totalIncome").textContent =
      formatMoney(income);

    document.getElementById("totalExpenses").textContent =
      formatMoney(expenses);

    document.getElementById("balance").textContent =
      formatMoney(income - expenses);

    list.replaceChildren();

    document.getElementById("emptyMessage").style.display =
      transactions.length ? "none" : "block";

    [...transactions].reverse().forEach(item => {
      const row = document.createElement("tr");

      const values = [
        item.date,
        item.type === "income" ? "إيراد" : "مصروف",
        item.description,
        formatMoney(item.amount) + " MRU"
      ];

      values.forEach(value => {
        const cell = document.createElement("td");
        cell.textContent = value;
        row.appendChild(cell);
      });

      const actionCell = document.createElement("td");
      const deleteButton = document.createElement("button");

      deleteButton.textContent = "حذف";
      deleteButton.className = "delete";
      deleteButton.type = "button";

      deleteButton.addEventListener("click", () => {
        if (confirm("هل تريد حذف هذه العملية؟")) {
          transactions = transactions.filter(
            transaction => transaction.id !== item.id
          );

          saveTransactions();
          render();
        }
      });

      actionCell.appendChild(deleteButton);
      row.appendChild(actionCell);
      list.appendChild(row);
    });
  }

  form.addEventListener("submit", function(event) {
    event.preventDefault();

    const description = descriptionInput.value.trim();
    const amount = Number(amountInput.value);
    const date = dateInput.value;

    if (!description || !Number.isFinite(amount) ||
        amount <= 0 || !date) {
      alert("يرجى إدخال بيانات صحيحة.");
      return;
    }

    transactions.push({
      id: Date.now().toString() + Math.random().toString(16).slice(2),
      type: typeInput.value,
      description: description,
      amount: amount,
      date: date
    });

    saveTransactions();
    render();

    form.reset();
    dateInput.value = new Date().toISOString().slice(0, 10);
    typeInput.value = "income";
    descriptionInput.focus();
  });

  render();
</script>

</body>
</html>
